{
  "name": "ai-portfolio-starter",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mutlumehmet/ai-portfolio-starter"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/cover-sizes.ts && next build",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate && tsx scripts/cover-sizes.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "project:upsert": "tsx scripts/upsert-project.ts",
    "project:delete": "tsx scripts/delete-project.ts",
    "rag:ingest": "tsx scripts/ingest.ts",
    "covers:measure": "tsx scripts/cover-sizes.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "mcp-handler": "^2.1.0",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "author": "Mehmet Mutlu",
  "license": "MIT",
  "description": "Open source portfolio starter with an AI chat, a job-fit check and an MCP server, grounded in your own content (Next.js, Prisma, Postgres with pgvector, OpenAI)."
}
