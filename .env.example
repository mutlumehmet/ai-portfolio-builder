# Copy this file to .env and fill it in. Never commit .env.

# Postgres with the pgvector extension.
# Neon (recommended for Vercel): create a free project at https://neon.tech and
# paste its connection string. Local Docker (`npm run db:up`) uses the value below.
# Neon URLs use Neon's serverless driver, anything else uses node-postgres.
# Set DATABASE_DRIVER=neon or DATABASE_DRIVER=pg to force one.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"

# Password for /admin. Use a long random value in production; the site refuses
# to start an admin session in production while this is still "change-me".
ADMIN_PASSWORD="change-me"

# Signs the admin session cookie. Any long random string, for example the
# output of `openssl rand -base64 32`. Rotating it logs every session out.
SESSION_SECRET="change-me-too"

# AI provider for the chat, fit check, MCP server and profile import.
# Any OpenAI-compatible API works. With only AI_API_KEY set, it is OpenAI
# (create a key at https://platform.openai.com/api-keys). OPENAI_API_KEY still
# works in place of AI_API_KEY. Set a monthly budget with your provider before
# you deploy (see SECURITY.md). Without a key the AI features are off.
AI_API_KEY=""
# Empty means OpenAI. For another provider, set its OpenAI-compatible base URL
# and a model it offers (examples below).
# AI_BASE_URL=""
# CHAT_MODEL="gpt-4.1-mini"

# Embeddings build the chat's search index. They use the AI_* values unless you
# set these. EMBEDDING_API_KEY on its own (no EMBEDDING_BASE_URL) means OpenAI.
# The Chunk table stores 1536-dimension vectors, which matches
# text-embedding-3-small; a model with another output size needs a schema change
# (or EMBEDDING_DIMENSIONS=1536 for a model that can shorten its output).
# EMBEDDING_API_KEY=""
# EMBEDDING_BASE_URL=""
# EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_DIMENSIONS=""
# EMBEDDING_MODEL="none" switches embeddings off (no chat, fit check or MCP).

# Examples (checked against each provider's docs in October 2026; models change):
#
# Anthropic (Claude). No embeddings, so add an OpenAI key for them:
#   AI_API_KEY="your Claude API key"
#   AI_BASE_URL="https://api.anthropic.com/v1/"
#   CHAT_MODEL="claude-haiku-5-5"
#   EMBEDDING_API_KEY="your OpenAI key"
#
# Google Gemini (embeddings: an OpenAI key as above is the safe route; or
# EMBEDDING_MODEL="gemini-embedding-001" with EMBEDDING_DIMENSIONS=1536):
#   AI_API_KEY="your Gemini API key"
#   AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
#   CHAT_MODEL="gemini-3.8-flash"
#
# OpenRouter (one key for chat and embeddings):
#   AI_API_KEY="your OpenRouter key"
#   AI_BASE_URL="https://openrouter.ai/api/v1"
#   CHAT_MODEL="openai/gpt-4.1-mini"
#   EMBEDDING_MODEL="openai/text-embedding-3-small"
#
# Ollama, on this machine only (not on Vercel). No key needed:
#   AI_BASE_URL="http://localhost:11434/v1/"
#   CHAT_MODEL="gpt-oss:20b"
#   EMBEDDING_API_KEY="your OpenAI key"   (or EMBEDDING_MODEL="none")

# Optional: the public URL of your site (overrides url in site.config.ts).
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Optional: feature flags, overriding site.config.ts (true or false).
# FEATURE_CHAT=true
# FEATURE_FIT_CHECK=true
# FEATURE_PARSE_JD=true
# FEATURE_MCP=true
# FEATURE_ADMIN=true
# FEATURE_CV=true
# FEATURE_EASTER_EGGS=false
# FEATURE_RATE_LIMIT=true

# Optional: per-IP limits for the AI endpoints (overrides site.config.ts).
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=100
