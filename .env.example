# Copy this file to .env and fill it in. Never commit .env.

# Postgres with the pgvector extension.
# Neon (recommended for Vercel): create a free project at https://neon.tech and
# paste its connection string. Local Docker (`npm run db:up`) uses the value below.
# Neon URLs use Neon's serverless driver, anything else uses node-postgres.
# Set DATABASE_DRIVER=neon or DATABASE_DRIVER=pg to force one.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"

# Password for /admin. Use a long random value in production; the site refuses
# to start an admin session in production while this is still "change-me".
ADMIN_PASSWORD="change-me"

# Signs the admin session cookie. Any long random string, for example the
# output of `openssl rand -base64 32`. Rotating it logs every session out.
SESSION_SECRET="change-me-too"

# OpenAI key for embeddings (npm run rag:ingest) and answers (chat, fit check, MCP).
# Create one at https://platform.openai.com/api-keys and set a monthly budget on
# its project before you deploy (see SECURITY.md).
OPENAI_API_KEY=""

# Optional: models. The Chunk table stores 1536-dimension vectors, which matches
# text-embedding-3-small. A model with another output size needs a schema change.
# CHAT_MODEL="gpt-4.1-mini"
# EMBEDDING_MODEL="text-embedding-3-small"

# Optional: the public URL of your site (overrides url in site.config.ts).
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Optional: feature flags, overriding site.config.ts (true or false).
# FEATURE_CHAT=true
# FEATURE_FIT_CHECK=true
# FEATURE_PARSE_JD=true
# FEATURE_MCP=true
# FEATURE_ADMIN=true
# FEATURE_CV=true
# FEATURE_EASTER_EGGS=false
# FEATURE_RATE_LIMIT=true

# Optional: per-IP limits for the AI endpoints (overrides site.config.ts).
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=100
